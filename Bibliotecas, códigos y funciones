import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import classification_report, roc_auc_score, ConfusionMatrixDisplay

def run_telecom_pipeline(url_data):
    # Carga de datos
    print("Iniciando carga de datos...")
    df = pd.read_csv(url_data)
    
    # Preprocesamiento simplificado (Pipeline de ejemplo)
    X = df.drop('Churn', axis=1)
    y = df['Churn']
    
    # Partición estratificada para manejar el desbalance (73/27)
    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.3, random_state=42, stratify=y
    )
    
    # Entrenamiento del modelo seleccionado (Regresión Logística)
    model = LogisticRegression(max_iter=1000, class_weight='balanced')
    model.fit(X_train, y_train)
    
    # Evaluación
    y_pred = model.predict(X_test)
    y_proba = model.predict_proba(X_test)[:, 1]
    
    print("\\n--- REPORTE DE DESEMPEÑO ---")
    print(classification_report(y_test, y_pred))
    print(f"ROC-AUC: {roc_auc_score(y_test, y_proba):.4f}")
    
    # Generación de Matriz de Confusión para el repositorio
    fig, ax = plt.subplots(figsize=(8, 6))
    ConfusionMatrixDisplay.from_estimator(model, X_test, y_test, cmap='Blues', ax=ax)
    plt.title('Matriz de Confusión - Telecom X')
    plt.savefig('confusion_matrix.png')
    print("\\n✅ Visualización 'confusion_matrix.png' generada.")

